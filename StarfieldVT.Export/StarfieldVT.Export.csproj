<Project Sdk="Microsoft.NET.Sdk">

  <!-- starfieldvt-export: the command-line bulk exporter. A separate console program, because
       StarfieldVT.exe is a window app and Windows shows no console output from one. It is
       published into the same folder as StarfieldVT.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>starfieldvt-export</AssemblyName>
    <RootNamespace>StarfieldVT.ExportTool</RootNamespace>
    <ApplicationIcon>..\StarfieldVT\starfieldvt.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Same as the window app: no libicu needed on minimal Linux installs. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarfieldVT.UI\StarfieldVT.UI.csproj" />
    <ProjectReference Include="..\StarfieldVT.Core\StarfieldVT.Core.csproj" />
  </ItemGroup>

</Project>
