<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:StarfieldVT.UI.View"
             xmlns:viewModel="using:StarfieldVT.UI.ViewModel"
             x:Class="StarfieldVT.UI.View.VoiceLineTable"
             x:Name="parent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False"
                  Name="DialogueGrid" ItemsSource="{Binding VoiceLines}"
                  SelectedItem="{Binding SelectedVoiceLine}"
                  DoubleTapped="DialogueGrid_OnDoubleTapped"
                  SelectionMode="Extended"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Voice Type" Binding="{Binding VoiceType}" Width="120" />
                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="200" />
                <DataGridTextColumn Header="Dialogue" Binding="{Binding Dialogue}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="5" Text="Filter" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="0, 5" VerticalContentAlignment="Center"
                     Watermark="Search dialogue text, e.g. &quot;good to see you&quot; or capt*"
                     ToolTip.Tip="Searches the lines in the table: the selected plugin or voice type, the voice types matching the filter on the left, or every plugin when the table is empty"
                     Text="{Binding VoiceLineFilterText}" />
        </Grid>
        <Grid Grid.Row="2" DataContext="{Binding ExportBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0,0,5">
                <CheckBox Content="Keep game folders" IsChecked="{Binding KeepFolders, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                          ToolTip.Tip="On: Plugin\VoiceType\... folders. Off: every file in one folder" />
                <CheckBox Margin="15,0,0,0" Content="Write list.csv" IsChecked="{Binding WriteCsv, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                          ToolTip.Tip="Also write list.csv in the export folder: each file with its plugin, voice type, game file and dialogue" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsIdle}">
                <Button Name="ExportBtn" Margin="5,0,0,5" Content="Export" Click="ExportBtn_OnClick"
                        ToolTip.Tip="Save the selected line as a .wav; with several selected (Ctrl+click or Shift+click), choose a folder" />
                <Button Margin="5,0,10,5" Content="{Binding AllShownText}" Click="ExportAllBtn_OnClick"
                        ToolTip.Tip="Export every line the table shows (the plugin or voice type and the filter) to a folder" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsExporting}">
                <ProgressBar Margin="5,0,0,5" Width="220" Minimum="0" Maximum="{Binding Total}" Value="{Binding Done}" />
                <Button Margin="5,0,10,5" Content="Cancel" Click="CancelExportBtn_OnClick"
                        ToolTip.Tip="Stop the export after the current file; list.csv lists what was written" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" Margin="5,0,5,5" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
