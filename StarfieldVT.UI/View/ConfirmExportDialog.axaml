<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StarfieldVT.UI.View.ConfirmExportDialog"
        Title="Export many files?"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Don't export" IsCancel="True" Click="No_Click" />
            <Button Content="Export" IsDefault="True" Click="Yes_Click" />
        </StackPanel>
    </StackPanel>
</Window>
