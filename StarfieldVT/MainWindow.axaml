<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:StarfieldVT"
        xmlns:starfieldVtUi="using:StarfieldVT.UI.View"
        x:Class="StarfieldVT.MainWindow"
        x:Name="MainWindowElement"
        Title="Starfield Voice Tool" Height="433" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Set Game Path" Click="SetGamePath_Click" />
                <MenuItem Header="Delete Cache" Click="DeleteCache_Click" />
                <MenuItem Header="Exit" Click="MenuItem_OnClick" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Name="IncludeAllModVoicesMenuItem"
                          Header="Include voices from all mod archives and loose files"
                          ToggleType="CheckBox"
                          Click="IncludeAllModVoices_Click"
                          ToolTip.Tip="Also finds mod voices packed in archives without &quot; - Voices&quot; in the name (e.g. &quot;MyMod - Main.ba2&quot;) and loose .wem files in Data\Sound\Voice. Loading takes longer." />
            </MenuItem>
        </Menu>

        <starfieldVtUi:VoiceTypeTree Grid.Row="2" Grid.Column="0" Name="VoiceTypeTree"
                                      VoiceTypeSelected="VoiceTypeTree_OnVoiceTypeSelected"
                                      MasterSelected="VoiceTypeTree_OnMasterSelected"
                                      SearchText="{Binding Path=SearchBarText}"
                                      ProgressChanged="VoiceTypeTree_OnProgressChanged" />

        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F50D;" Margin="10" VerticalAlignment="Center" FontSize="20" />
            <TextBox Grid.Column="1" Margin="5,10,10,10"
                     VerticalContentAlignment="Center"
                     Watermark="Filter voice types, e.g. sarah"
                     ToolTip.Tip="Shows voice types whose name contains this text, in the tree and the table"
                     Text="{Binding Path=SearchBarText, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="&#x23F9;" Height="30" Width="30" Click="StopButton_OnClick"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Stop playback" />
        </Grid>

        <starfieldVtUi:VoiceLineTable DataContext="{Binding VoiceLineTableViewModel}"
                                       Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Grid.Column="0" Orientation="Horizontal" Margin="5">
            <ProgressBar Name="TreeBuilderProgressBar" Height="15" Width="120" IsVisible="False" />
            <TextBlock Name="ProgressText" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
