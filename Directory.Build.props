<Project>
  <!-- One place for the app version. Bumping it also invalidates users' voice line caches. -->
  <!-- Only the StarfieldVT projects; the BnkExtractor submodule keeps its own settings. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('StarfieldVT'))">
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
  </PropertyGroup>
</Project>
